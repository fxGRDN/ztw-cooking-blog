---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/recipes/pieczone-nozki-z-kurczaka.png";
import { SITE_TITLE } from "../consts";
import { Font } from "astro:assets";
import atkinsonRegular from "../assets/fonts/atkinson-regular.woff?url";
import atkinsonBold from "../assets/fonts/atkinson-bold.woff?url";

interface Props {
    title: string;
    description: string;
    image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const optimizeFonts = process.env.OPTIMIZE_FONTS !== "false";
const fallbackFontCss = `@font-face{font-family:'Atkinson';src:url('${atkinsonRegular}') format('woff');font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:'Atkinson';src:url('${atkinsonBold}') format('woff');font-weight:700;font-style:normal;font-display:swap}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const { title, description, image = FallbackImage } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<link rel="icon" href={`${base}/favicon.ico`} />
<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
<link
    rel="alternate"
    type="application/rss+xml"
    title={SITE_TITLE}
    href={`${base}/rss.xml`}
/>
<meta name="generator" content={Astro.generator} />

<!-- Fonts: Astro Fonts API + preload (OPTIMIZE_FONTS) or plain @font-face -->
{optimizeFonts ? (
    <Font cssVariable="--font-atkinson" preload />
) : (
    <style set:html={fallbackFontCss} />
)}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
