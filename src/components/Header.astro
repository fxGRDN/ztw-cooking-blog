---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header>
    <nav>
        <div class="brand">
            <a href={`${base}/`} class="brand-link">
                <span class="brand-badge" aria-hidden="true">
                    <svg
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z" />
                        <line x1="6" y1="17" x2="18" y2="17" />
                    </svg>
                </span>
                <div class="brand-info">
                    <span class="brand-title">{SITE_TITLE}</span>
                    <span class="brand-tagline">Domowe smaki i inspiracje</span>
                </div>
            </a>
        </div>
        <div class="internal-links">
            <HeaderLink href={`${base}/`}>Strona główna</HeaderLink>
            <HeaderLink href={`${base}/blog/`}>Przepisy</HeaderLink>
        </div>
        <div class="social-links"></div>
    </nav>
</header>
<style>
    header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(254, 250, 244, 0.94);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--border-subtle);
        box-shadow: 0 2px 10px rgba(60, 40, 20, 0.03);
        padding: 0.7rem 1.5rem;
        transition: all 0.2s ease;
    }

    nav {
        max-width: 1020px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .brand-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--text-main);
    }

    .brand-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: var(--bg-card);
        color: var(--accent);
        border: 1px solid var(--border-subtle);
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(60, 40, 25, 0.05);
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .brand-link:hover .brand-badge {
        transform: scale(1.05);
        border-color: var(--accent);
    }

    .brand-info {
        display: flex;
        flex-direction: column;
    }

    .brand-title {
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--text-main);
        line-height: 1.15;
    }

    .brand-tagline {
        font-size: 0.75rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    .internal-links {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(240, 230, 218, 0.4);
        padding: 0.3rem 0.4rem;
        border-radius: 9999px;
        border: 1px solid var(--border-subtle);
    }

    .internal-links :global(a) {
        padding: 0.45rem 1rem;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.95rem;
        border-radius: 9999px;
        transition: all 0.18s ease;
        text-decoration: none;
    }

    .internal-links :global(a:hover) {
        color: var(--accent);
        background: rgba(255, 255, 255, 0.6);
    }

    .internal-links :global(a.active) {
        color: white;
        background: var(--accent);
        box-shadow: 0 2px 8px var(--accent-glow);
        text-decoration: none;
    }

    .social-links a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        color: var(--text-muted);
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        transition: all 0.2s ease;
    }

    .social-links a:hover {
        color: var(--accent);
        border-color: var(--accent);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px var(--accent-glow);
    }

    @media (max-width: 720px) {
        header {
            padding: 0.6rem 0.8rem;
        }
        .brand-tagline {
            display: none;
        }
        .social-links {
            display: none;
        }
        .internal-links :global(a) {
            padding: 0.35rem 0.7rem;
            font-size: 0.85rem;
        }
    }
</style>
