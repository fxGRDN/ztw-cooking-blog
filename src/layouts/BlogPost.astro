---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, author, tags } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="pl">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 820px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2rem 0 4rem 0;
			}

			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--text-muted);
				margin-bottom: 1.5rem;
				padding: 0.4rem 0.8rem;
				border-radius: 8px;
				background: rgba(240, 230, 218, 0.4);
				border: 1px solid var(--border-subtle);
				transition: all 0.2s ease;
			}

			.back-link:hover {
				color: var(--accent);
				background: var(--bg-card);
				transform: translateX(-3px);
			}

			article {
				background: var(--bg-card);
				border: 1px solid var(--border-subtle);
				border-radius: 24px;
				overflow: hidden;
				box-shadow: var(--box-shadow);
			}

			.hero-image {
				width: 100%;
				max-height: 440px;
				overflow: hidden;
				background: var(--bg-warm);
			}

			.hero-image img {
				width: 100%;
				height: 100%;
				max-height: 440px;
				object-fit: cover;
				display: block;
				border-radius: 0;
			}

			.article-body {
				padding: 2.5rem 3rem;
			}

			.recipe-header {
				text-align: center;
				margin-bottom: 2rem;
				padding-bottom: 1.8rem;
				border-bottom: 1px solid var(--border-subtle);
			}

			.meta-badges {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: center;
				gap: 0.8rem;
				margin-bottom: 1rem;
				font-size: 0.9rem;
			}

			.meta-badge {
				display: inline-flex;
				align-items: center;
				padding: 0.35rem 0.9rem;
				border-radius: 9999px;
				background: var(--bg-card-accent);
				border: 1px solid var(--border-subtle);
				color: var(--text-muted);
			}

			.meta-badge.author {
				font-weight: 700;
				color: var(--accent);
				background: var(--accent-light);
				border-color: rgba(194, 65, 12, 0.2);
			}

			.recipe-title {
				font-size: 2.6rem;
				line-height: 1.2;
				color: var(--text-main);
				margin: 0.5rem 0 1rem 0;
				letter-spacing: -0.02em;
			}

			.recipe-description {
				font-size: 1.15rem;
				color: var(--text-muted);
				max-width: 650px;
				margin: 0 auto 1.2rem auto;
				line-height: 1.6;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				justify-content: center;
				margin-top: 1rem;
			}

			.tag {
				background-color: var(--bg-page);
				color: var(--text-muted);
				border: 1px solid var(--border-subtle);
				font-size: 0.8rem;
				padding: 0.25rem 0.75rem;
				border-radius: 9999px;
				font-weight: 600;
				transition: all 0.18s ease;
			}

			.tag:hover {
				color: var(--accent);
				border-color: var(--accent);
				background: var(--accent-light);
			}

			.last-updated-on {
				font-style: italic;
				font-size: 0.85rem;
				color: var(--text-light);
				margin-top: 0.5rem;
			}

			@media (max-width: 720px) {
				.article-body {
					padding: 1.5rem 1.2rem;
				}
				.recipe-title {
					font-size: 2rem;
				}
				.recipe-description {
					font-size: 1rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<a href={`${base}/blog/`} class="back-link">
				<span>&larr;</span> Wróć do wszystkich przepisów
			</a>

			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={480} src={heroImage} alt={title} />}
				</div>

				<div class="article-body">
					<header class="recipe-header">
						<div class="meta-badges">
							{author && (
								<span class="meta-badge author">
									Autor: {author}
								</span>
							)}
							<span class="meta-badge">
								Data publikacji: <FormattedDate date={pubDate} />
							</span>
						</div>

						<h1 class="recipe-title">{title}</h1>

						{description && <p class="recipe-description">{description}</p>}

						{tags && tags.length > 0 && (
							<div class="tags">
								{tags.map((tag) => (
									<a href={`${base}/blog/?tag=${tag}`} class="tag">
										#{tag}
									</a>
								))}
							</div>
						)}

						{updatedDate && (
							<div class="last-updated-on">
								Ostatnia aktualizacja: <FormattedDate date={updatedDate} />
							</div>
						)}
					</header>

					<div class="prose">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
