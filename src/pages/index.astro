---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="pl">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 2rem 0;
			}
			.hero h1 {
				font-size: 2.8rem;
				margin-bottom: 0.5rem;
			}
			.hero p {
				font-size: 1.25rem;
				color: rgb(var(--gray));
				max-width: 650px;
				margin: 0 auto 1.5rem auto;
			}
			.section-title {
				margin-top: 2rem;
				margin-bottom: 1.5rem;
				border-bottom: 2px solid rgb(var(--gray-light));
				padding-bottom: 0.5rem;
			}
			.recipe-card {
				display: block;
				background: #fff;
				border-radius: 12px;
				overflow: hidden;
				box-shadow: var(--box-shadow);
				text-decoration: none;
				color: inherit;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
				margin-bottom: 2rem;
			}
			.recipe-card:hover {
				transform: translateY(-4px);
			}
			.recipe-card img {
				width: 100%;
				height: auto;
				max-height: 400px;
				object-fit: cover;
				border-radius: 12px 12px 0 0;
			}
			.recipe-card-content {
				padding: 1.5rem;
			}
			.recipe-card-content h3 {
				margin: 0 0 0.5rem 0;
				color: rgb(var(--black));
			}
			.recipe-card-content p {
				color: rgb(var(--gray-dark));
				margin-bottom: 0.8rem;
			}
			.recipe-meta {
				font-size: 0.875rem;
				color: rgb(var(--gray));
				margin-bottom: 0.5rem;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 0.5rem;
			}
			.tag {
				background-color: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font-size: 0.75rem;
				padding: 0.15rem 0.5rem;
				border-radius: 9999px;
				font-weight: 500;
			}
			.view-all {
				text-align: center;
				margin: 2rem 0;
			}
			.btn {
				display: inline-block;
				padding: 0.75rem 1.5rem;
				background-color: var(--accent);
				color: white;
				border-radius: 8px;
				text-decoration: none;
				font-weight: bold;
				transition: background-color 0.2s ease;
			}
			.btn:hover {
				background-color: var(--accent-dark);
				color: white;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>🍲 Witaj na Blogu Kulinarnym!</h1>
				<p>
					Odkryj proste, wyśmienite i pełne aromatu przepisy na każdą okazję. Gotuj z pasją w domowym zaciszu!
				</p>
			</section>

			<section>
				<h2 class="section-title">Najnowsze przepisy</h2>
				{posts.length > 0 ? (
					<div>
						{posts.slice(0, 3).map((post) => (
							<a href={`/blog/${post.id}/`} class="recipe-card">
								{post.data.heroImage && (
									<Image width={720} height={360} src={post.data.heroImage} alt={post.data.title} />
								)}
								<div class="recipe-card-content">
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<div class="recipe-meta">
										<span>Data dodania: <FormattedDate date={post.data.pubDate} /></span>
										{post.data.author && <span> • Autor: {post.data.author}</span>}
									</div>
									{post.data.tags && post.data.tags.length > 0 && (
										<div class="tags">
											{post.data.tags.map((tag) => (
												<span class="tag">#{tag}</span>
											))}
										</div>
									)}
								</div>
							</a>
						))}
					</div>
				) : (
					<p>Brak przepisów do wyświetlenia.</p>
				)}

				<div class="view-all">
					<a href="/blog" class="btn">Zobacz wszystkie przepisy &rarr;</a>
				</div>
			</section>

			<section>
				<h2 class="section-title">O czym jest ten blog?</h2>
				<p>
					Nasz blog to miejsce stworzone z miłości do pysznego jedzenia. Znajdziesz tutaj sprawdzone receptury, porady kuchenne oraz inspiracje z różnych zakątków świata – od klasycznych zup po dania kuchni orientalnej.
				</p>
				<p>
					Każdy przepis zawiera listę niezbędnych składników oraz instrukcję krok po kroku, dzięki czemu gotowanie stanie się proste i przyjemne zarówno dla początkujących, jak i zaawansowanych kucharzy.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
